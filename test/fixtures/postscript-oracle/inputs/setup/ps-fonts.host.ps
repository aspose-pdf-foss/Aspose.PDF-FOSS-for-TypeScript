%!PS
/NimbusSans-Regular findfont dup /FontName get (ORACLE-FONT:NimbusSans-Regular=) print 256 string cvs print (\n) print /PathLoad get (ORACLE-PATH:NimbusSans-Regular=) print 4096 string cvs print (\n) print
/LiberationSans findfont dup length dict begin { 1 index /FID ne { def } { pop pop } ifelse } forall /Encoding StandardEncoding def currentdict end /LiberationSans exch definefont pop
/LiberationSans findfont dup /FontName get (ORACLE-FONT:LiberationSans=) print 256 string cvs print (\n) print /PathLoad get (ORACLE-PATH:LiberationSans=) print 4096 string cvs print (\n) print
<< /PageSize [595 842] >> setpagedevice
