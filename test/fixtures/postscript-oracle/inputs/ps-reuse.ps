%!PS-Adobe-3.0
<< /PageSize [160 120] >> setpagedevice
/tiles << /PatternType 1 /PaintType 1 /TilingType 1 /BBox [0 0 8 8]
/XStep 12 /YStep 12 /PaintProc { pop .1 .7 .2 setrgbcolor 0 0 8 8 rectfill
0 setgray /NimbusSans-Regular 5 selectfont 1 1 moveto (P) show } >> matrix makepattern def
<< /FormType 1 /BBox [0 0 80 65] /Matrix [1 .1 .15 1 40 20]
/PaintProc { pop tiles setpattern 0 0 80 60 rectfill 0 setgray
/NimbusSans-Regular 12 selectfont 8 40 moveto (F) show } >> execform
showpage
