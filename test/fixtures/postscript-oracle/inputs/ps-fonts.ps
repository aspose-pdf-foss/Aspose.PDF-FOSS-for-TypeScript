%!PS-Adobe-3.0
<< /PageSize [200 120] >> setpagedevice
/NimbusSans-Regular 24 selectfont 12 96 moveto (AWgy) show
1 0 0 setrgbcolor 12 92 (A) stringwidth pop 2 rectfill 0 setgray
/NimbusSans-Regular 8 selectfont 178 100 moveto (A) show
/LiberationSans 24 selectfont 12 64 moveto (AWgy) show
0 0 1 setrgbcolor 12 60 (A) stringwidth pop 2 rectfill 0 setgray
/Proc << /FontType 3 /FontMatrix [.001 0 0 .001 0 0] /FontBBox [0 0 600 700]
/Encoding StandardEncoding /BuildGlyph { pop pop 600 0 setcharwidth
0 0 500 600 rectfill 0.7 setgray 100 100 300 400 rectfill } >> definefont pop
/Proc 24 selectfont 12 24 moveto (AB) show
gsave 120 30 translate [1 .3 -.2 1 0 0] concat /NimbusSans-Regular 16 selectfont
0 0 moveto (A) show grestore showpage
