{
 "reader": "Adobe Acrobat Reader 26.1.21691.0 (Acrobat DC, Reader mode, Protected Mode on)",
 "decisions": {
  "simplexEvenArea": "never",
  "pageEvenOutsideDuplex": "fatal",
  "duplexTrailingBack": false,
  "noMatch": "nothing",
  "orderedParity": "alwaysOdd"
 },
 "probes": {
  "q1": { "expect": "match", "areas": ["B", "A", "A"],
   "fields": { "form1[0].item[0].f[0]": 2, "form1[0].item[1].f[0]": 3 } },
  "q2": { "expect": "match", "areas": ["C", "B", "A", "B"],
   "fields": { "form1[0].item[0].f[0]": 2, "form1[0].item[1].f[0]": 3, "form1[0].item[2].f[0]": 4 } },
  "q3": { "expect": "match", "areas": ["A", "C", "C"],
   "fields": { "form1[0].item[0].f[0]": 2, "form1[0].item[1].f[0]": 3 } },
  "q4": { "expect": "match", "areas": ["C", "B", "A", "B", "A"],
   "fields": { "form1[0].X[0].Y[0].f[0]": 2, "form1[0].X[0].Y[1].f[0]": 3, "form1[0].Z[0].f[0]": 5 },
   "note": "page 4 is the blank filler before the pageOdd target; no trailing back page after page 5, contrary to Example 8.27" },
  "q5": { "expect": "match", "areas": ["A", "A", "A", "B"],
   "fields": { "form1[0].item[0].f[0]": 2, "form1[0].item[1].f[0]": 3, "form1[0].item[2].f[0]": 4 } },
  "q6": { "expect": "match", "areas": ["D"],
   "fields": { "form1[0].item[0].f[0]": 1 } },
  "q7": { "expect": "match", "areas": ["A", "B", "B", "C"],
   "fields": { "form1[0].item[0].f[0]": 2, "form1[0].item[1].f[0]": 3, "form1[0].item[2].f[0]": 4 } },
  "q8": { "expect": "match", "areas": ["A", "A", "A", "B"],
   "fields": { "form1[0].item[0].f[0]": 2, "form1[0].item[1].f[0]": 3 },
   "note": "the last page area's 2in content area cannot hold the final item, so B is appended blank" },
  "q9": { "expect": "match", "areas": ["A", "B", "A"],
   "fields": { "form1[0].item[0].f[0]": 2, "form1[0].item[1].f[0]": 3 },
   "note": "no blank back page after a final odd page" },
  "q10": { "expect": "refused", "reason": "XFA 3.3 p. 304", "areas": [],
   "fields": { "form1[0].item[0].f[0]": 0 },
   "note": "Reader opened the document and drew a blank page: no layout, no oracle text" },
  "q11": { "expect": "match", "areas": ["A", "A"],
   "fields": { "form1[0].S0[0].f[0]": 1, "form1[0].S1[0].f[0]": 2 },
   "note": "under orderedOccurrence a pageOdd startNew break takes the next page with no filler: every page is odd" },
  "q12": { "expect": "refused", "reason": "every page is a front (odd) surface", "areas": [],
   "fields": { "form1[0].S1[0].f[0]": 0 },
   "note": "Reader opened no document window at all, three attempts" },
  "q13": { "expect": "match", "areas": ["C", "F", "A"],
   "fields": { "form1[0].S0[0].f[0]": 3 } },
  "q14": { "expect": "match", "areas": ["A", "A", "A"],
   "fields": { "form1[0].item[0].f[0]": 2, "form1[0].item[1].f[0]": 3 } },
  "q15": { "expect": "refused", "reason": "every page is a front (odd) surface", "areas": [],
   "fields": { "form1[0].S1[0].f[0]": 0 },
   "note": "pageEven under orderedOccurrence: Reader opened no document window at all, as for q12" }
 }
}
