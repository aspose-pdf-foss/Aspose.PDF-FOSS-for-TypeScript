  "n4": { "expect": "match", "areas": ["A", "B", "C", "D", "F"],
   "fields": { "form1[0].S[0].f[0]": 2, "form1[0].S[1].f[0]": 3, "form1[0].T[0].g[0]": 4, "form1[0].T[1].g[0]": 5 },
