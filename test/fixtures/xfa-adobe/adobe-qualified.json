   "note": "page 4 is the entered set's blank filler, not the outer H" },
  "n10": { "expect": "match", "areas": ["B", "C", "B", "C"],
   "fields": { "form1[0].item[0].f[0]": 2, "form1[0].item[1].f[0]": 3, "form1[0].item[2].f[0]": 4 },
   "note": "n5 with the siblings swapped: still the first" }
 }
