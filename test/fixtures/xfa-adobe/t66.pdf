<xdp:xdp xmlns:xdp="http://ns.adobe.com/xdp/"><template xmlns="http://www.xfa.org/schema/xfa-template/2.8/"><subform name="form1" layout="tb" locale="en_US">
  <pageSet><pageArea name="P1" id="P1"><medium short="8.5in" long="11in" stock="letter"/>
  <contentArea name="A" x="0.5in" y="0.5in" w="7.5in" h="5in"/><contentArea name="B" x="0.5in" y="5.5in" w="7.5in" h="5in"/></pageArea></pageSet>
  <event activity="docReady" ref="$host"><script contentType="application/x-javascript">
if (typeof probeDone == "undefined") {
  probeDone = true;
  var rows = [];
  function walk(n) {
    for (var i = 0; i &lt; n.nodes.length; i++) {
      var c = n.nodes.item(i);
      if (c.className == "field" || c.className == "subform" || c.className == "draw") {
        var span = xfa.layout.pageSpan(c);
        var frags = [];
        for (var k = 0; k &lt; span; k++)
          frags.push([xfa.layout.page(c) + k, xfa.layout.x(c, "pt", k), xfa.layout.y(c, "pt", k), xfa.layout.w(c, "pt", k), xfa.layout.h(c, "pt", k)].join(","));
        rows.push(c.somExpression + "=" + frags.join(";"));
        walk(c);
      }
    }
  }
  var msg = "";
  try {
    walk(xfa.form);
    var areas = [];
    for (var p = 0; p &lt; xfa.layout.pageCount(); p++) {
      var ds = xfa.layout.pageContent(p, "draw", true);
      var nm = [];
      for (var j = 0; j &lt; ds.length; j++) nm.push(ds.item(j).name);
      areas.push((p + 1) + ":" + nm.join("/"));
    }
    msg = "pages=" + xfa.layout.pageCount() + "\nareas=" + areas.join(" ") + "\n" + rows.join("\n");
  }
  catch (e) { msg = "ERR " + e; }
  xfa.form.form1.oracle.out.rawValue = msg;
}</script></event>
  <subform name="oracle" layout="tb" w="7.5in"><field name="out" w="7.5in" h="3in"><font typeface="Courier New" size="8pt"/><ui><textEdit multiLine="1"/></ui></field></subform>
  
<subform name="S" layout="tb" w="7.5in"><keep intact="pageArea"/><draw name="S1" w="2in" h="50pt"><value><text>S1</text></value></draw><draw name="S2" w="2in" h="50pt"><value><text>S2</text></value></draw><draw name="S3" w="2in" h="50pt"><value><text>S3</text></value></draw><draw name="S4" w="2in" h="50pt"><value><text>S4</text></value></draw><draw name="S5" w="2in" h="50pt"><value><text>S5</text></value></draw><draw name="S6" w="2in" h="50pt"><value><text>S6</text></value></draw></subform>

</subform></template><xfa:datasets xmlns:xfa="http://www.xfa.org/schema/xfa-data/1.0/"><xfa:data/></xfa:datasets><config xmlns="http://www.xfa.org/schema/xci/2.8/"><agent name="designer"><destination>pdf</destination></agent><present><pdf><version>1.7</version><scriptModel>XFA</scriptModel><interactive>1</interactive></pdf><common><data><adjustData>1</adjustData></data></common><script><runScripts>both</runScripts></script></present><acrobat><acrobat7><dynamicRender>required</dynamicRender></acrobat7><common><validate>preSubmit</validate></common></acrobat></config></xdp:xdp>
endstream
